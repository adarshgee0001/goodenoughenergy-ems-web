PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/ems?schema=public"

JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="1d"

# MQTT Configuration
MQTT_BROKER_URL=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
# IMPORTANT: Use a unique client ID per environment (e.g. ems_backend_local, ems_backend_staging)
MQTT_CLIENT_ID=ems_backend_local
MQTT_PROTOCOL=mqtts
MQTT_TOPIC=

# ─────────────────────────────────────────────────────────────────────────────
# Admin Bootstrap Seed (DEVELOPMENT ONLY)
# Required before running: npx prisma db seed
# Set these in your LOCAL backend/.env — never commit real values.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP Configuration (for Client Invitation Emails)
# Supports any SMTP provider (Gmail App Password, Brevo, Mailgun SMTP, etc.)
# Leave blank to disable email sending (invitation status will report not sent).
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend URL (used to construct login links in invitation emails)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173



EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=your-email@gmail.com

